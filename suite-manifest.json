{
  "schema": 1,
  "suite": "eMuleBB Suite",
  "platform": "windows-x64",
  "defaultCore": "mfc",
  "controller": "trackmulebb",
  "cores": {
    "mfc":  { "product": "emulebb" },
    "rust": { "product": "emulebb-rust" }
  },
  "products": {
    "emulebb":       { "repo": "emulebb/emulebb",       "role": "ed2k-core",  "assetPattern": "emulebb-*-x64.zip" },
    "emulebb-rust":  { "repo": "emulebb/emulebb-rust",  "role": "ed2k-core",  "assetPattern": "emulebb-rust-*-x64*.zip" },
    "qbittorrentbb": { "repo": "emulebb/qbittorrentbb", "role": "bittorrent", "assetPattern": "qbittorrentbb-*-x64*.zip" },
    "trackmulebb":   { "repo": "emulebb/trackmulebb",   "role": "controller", "assetPattern": "trackmulebb-*.zip" }
  },
  "alwaysInstall": ["qbittorrentbb"],
  "optional": ["trackmulebb"],
  "notes": {
    "controller": "TrackMuleBB is the single capability-driven controller; it drives the installed core via /api/v1 capability negotiation. aMuTorrent is deprecated (legacy-only inside the frozen 0.7.3 bundle) and intentionally not offered here."
  }
}
