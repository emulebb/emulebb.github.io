{%- macro section_heading(section) -%}
<div class="section-heading">
<p class="eyebrow">{{ section.eyebrow }}</p>
<h2>{{ section.h2 }}</h2>
{%- if section.p %}
<p>{{ section.p | safe }}</p>
{%- endif %}
</div>
{%- endmacro -%}
{%- macro card_grid(label, class_name, cards, title_tag="h3") -%}
<div aria-label="{{ label }}" class="{{ class_name }}">
{%- for card in cards %}
<article>
<span>{{ card.span }}</span>
{%- if title_tag == "strong" %}
<strong>{{ card.h3 }}</strong>
{%- else %}
<h3>{{ card.h3 }}</h3>
{%- endif %}
<p>{{ card.p | safe }}</p>
</article>
{%- endfor %}
</div>
{%- endmacro -%}
<!doctype html>
<html lang="{{ page.html_lang }}">
<head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1" name="viewport"/>
<meta content="{{ content.meta_description }}" name="description"/>
<meta content="index,follow" name="robots"/>
<meta content="eMuleBB" name="author"/>
<meta content="{{ content.og_title }}" property="og:title"/>
<meta content="{{ content.og_description }}" property="og:description"/>
<meta content="website" property="og:type"/>
<meta content="{{ page.url }}" property="og:url"/>
<meta content="eMule broadband edition" property="og:site_name"/>
<meta content="summary" name="twitter:card"/>
<link href="{{ page.url }}" rel="canonical"/>
<link href="{{ site_base_url }}/sitemap.xml" rel="sitemap" type="application/xml"/>
{%- for alternate in alternates -%}
<link href="{{ alternate.url }}" hreflang="{{ alternate.hreflang }}" rel="alternate"/>
{%- endfor %}
<link href="{{ page.favicon_href }}" rel="icon" type="image/x-icon"/>
<title>{{ content.title }}</title>
<link href="{{ pico_cdn }}" rel="stylesheet"/>
<link href="{{ page.stylesheet_href }}" rel="stylesheet"/>
<script async src="https://www.googletagmanager.com/gtag/js?id={{ ga_measurement_id }}"></script>
<script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', '{{ ga_measurement_id }}');
    </script>
<script type="application/ld+json">
      {
              "@context": "https://schema.org",
              "@type": "SoftwareApplication",
              "name": "eMule broadband edition",
              "alternateName": "eMuleBB",
              "applicationCategory": "FileSharingApplication",
              "operatingSystem": "Windows",
              "url": "{{ page.url }}",
              "codeRepository": "https://github.com/emulebb/emulebb",
              "description": {{ content.structured_description | tojson }}
      }
    </script>
{%- if page.directory == "" %}
<script type="application/ld+json">
      {
              "@context": "https://schema.org",
              "@type": "WebSite",
              "name": "eMule broadband edition",
              "alternateName": ["eMuleBB", "emulebb"],
              "url": "{{ site_base_url }}/"
      }
    </script>
{%- endif %}
</head>
<body>
<header class="site-header">
<a aria-label="eMule broadband edition home" class="brand" href="#top">
<img alt="{{ content.brand_logo.alt }}" class="brand-logo" decoding="async" height="160" src="{{ content.brand_logo.src }}" width="151"/>
</a>
<button aria-controls="primary-nav" aria-expanded="false" aria-label="{{ content.menu.open_label }}" class="menu-toggle" type="button">
<span class="menu-toggle-label">{{ content.menu.label }}</span>
</button>
<nav aria-label="{{ content.nav_label }}" id="primary-nav">
{%- for item in content.nav %}
{%- if item.href %}
<a{% if item.class is defined and item.class %} class="{{ item.class }}"{% endif %} href="{{ item.href }}">{{ item.label }}</a>
{%- else %}
<a{% if item.class is defined and item.class %} class="{{ item.class }}"{% endif %} href="#{{ item.id }}">{{ item.label }}</a>
{%- endif %}
{%- endfor %}
</nav>
</header>
<main id="top">
<section class="hero">
<div class="hero-copy">
<p class="eyebrow">{{ content.hero.eyebrow }}</p>
<h1>{{ content.hero.h1 }}</h1>
<p class="lead">{{ content.hero.lead }}</p>
<div aria-label="{{ content.project_links_label }}" class="actions">
<a class="button primary" href="#install">{{ content.hero.install }}</a>
<a class="button secondary" href="https://github.com/emulebb/emulebb">{{ content.hero.source }}</a>
</div>
<div aria-label="{{ content.release_downloads_label }}" class="release-links">
<span>{{ content.release_downloads_label }}</span>
{%- for release in content.release_downloads %}
<a href="{{ release.href }}">{{ release.title }}</a>
{%- endfor %}
</div>
</div>
<aside aria-label="{{ content.product_summary_label }}" class="hero-panel">
<p class="panel-kicker">{{ content.hero.panel_kicker }}</p>
<h2>{{ content.hero.panel_h2 }}</h2>
<p>{{ content.hero.panel_p }}</p>
<ul class="signal-list">
{%- for signal in content.hero.signals %}
<li>{{ signal }}</li>
{%- endfor %}
</ul>
</aside>
</section>
{%- if content.install_callout %}
<section class="testing-callout install-callout" id="{{ content.install_callout.id }}">
<div>
<p class="eyebrow">{{ content.install_callout.eyebrow }}</p>
<h2>{{ content.install_callout.h2 }}</h2>
<p>{{ content.install_callout.p | safe }}</p>
<div aria-label="{{ content.install_callout.command_label }}" class="install-command">
<div class="install-command-header">
<strong>{{ content.install_callout.command_label }}</strong>
<button class="copy-command" data-copy-error="{{ content.install_callout.copy_error }}" data-copy-label="{{ content.install_callout.copy }}" data-copy-success="{{ content.install_callout.copied }}" data-copy-text="{{ content.install_callout.command }}" type="button">{{ content.install_callout.copy }}</button>
</div>
<code>{{ content.install_callout.command }}</code>
</div>
<p class="install-standalone">{{ content.install_callout.standalone | safe }}</p>
</div>
<div class="testing-actions">
<a href="{{ content.install_callout.primary_href }}">{{ content.install_callout.primary }}</a>
<a href="{{ content.install_callout.secondary_href }}">{{ content.install_callout.secondary }}</a>
</div>
</section>
{%- endif %}
<section class="intro">
<p>{{ content.intro | safe }}</p>
</section>
<section class="section motivation" id="why">
{{ section_heading(content.why) }}
{{ card_grid("eMuleBB motivation", "motivation-grid", content.why.cards) }}
</section>
<section class="section" id="features">
{{ section_heading(content.features) }}
{{ card_grid("eMule broadband feature groups", "feature-table", content.features.cards) }}
</section>
<section class="section docs" id="docs">
{{ section_heading(content.docs) }}
<div class="guide-grid guide-compact">
{%- for card in content.guide.cards %}
<article>
<span>{{ "%02d"|format(loop.index) }}</span>
<h3>{{ card.h3 }}</h3>
<p>{{ card.p | safe }}</p>
</article>
{%- endfor %}
</div>
<div class="automation-copy docs-automation">
<p>{{ content.automation.p | safe }}</p>
<ul aria-label="{{ content.automation.pills_label }}" class="api-list">
{%- for pill in content.automation.pills %}
<li>{{ pill }}</li>
{%- endfor %}
</ul>
</div>
<div class="doc-list">
{%- for link in content.docs.links %}
<a href="{{ link.href }}">
<strong>{{ link.title }}</strong>
<span>{{ link.text }}</span>
</a>
{%- endfor %}
</div>
</section>
<section class="section release" id="release">
{{ section_heading(content.release) }}
{{ card_grid("eMuleBB release proof", "release-grid", content.release.cards, "strong") }}
</section>
<section class="section repos" id="repos">
{{ section_heading(content.repos) }}
<div class="repo-list">
{%- for repo in content.repos.links %}
<a href="{{ repo.href }}">
<strong>{{ repo.title }}</strong>
<span>{{ repo.text }}</span>
</a>
{%- endfor %}
</div>
</section>
</main>
<footer>
<span>eMule broadband edition</span>
<div aria-label="{{ content.footer_links_label }}" class="footer-links">
        <a href="{{ language_href }}">{{ content.languages_link_label }}</a>
        <a href="https://github.com/emulebb">GitHub</a>
        <a href="https://discord.gg/uWQa9g37">Discord</a>
      </div>
</footer>
<script>
      (function () {
        var button = document.querySelector(".menu-toggle");
        var nav = document.getElementById("primary-nav");
        if (!button || !nav) {
          return;
        }
        function setOpen(open) {
          nav.classList.toggle("is-open", open);
          button.setAttribute("aria-expanded", String(open));
          button.setAttribute("aria-label", open ? {{ content.menu.close_label | tojson }} : {{ content.menu.open_label | tojson }});
        }
        setOpen(false);
        button.addEventListener("click", function () {
          setOpen(button.getAttribute("aria-expanded") !== "true");
        });
        nav.addEventListener("click", function (event) {
          if (event.target && event.target.closest("a")) {
            setOpen(false);
          }
        });
      })();
      (function () {
        var buttons = document.querySelectorAll(".copy-command");
        if (!buttons.length || !navigator.clipboard) {
          buttons.forEach(function (button) {
            button.hidden = true;
          });
          return;
        }
        buttons.forEach(function (button) {
          var label = button.getAttribute("data-copy-label") || button.textContent;
          var success = button.getAttribute("data-copy-success") || label;
          var error = button.getAttribute("data-copy-error") || label;
          button.addEventListener("click", function () {
            navigator.clipboard.writeText(button.getAttribute("data-copy-text") || "").then(function () {
              button.textContent = success;
              window.setTimeout(function () {
                button.textContent = label;
              }, 1600);
            }, function () {
              button.textContent = error;
              window.setTimeout(function () {
                button.textContent = label;
              }, 2200);
            });
          });
        });
      })();
    </script>
</body>
</html>
