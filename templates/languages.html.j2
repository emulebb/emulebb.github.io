<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1" name="viewport"/>
<meta content="dark" name="color-scheme"/>
<meta content="#0b1016" name="theme-color"/>
<meta content="Choose a language for the eMule broadband edition website." name="description"/>
<meta content="index,follow" name="robots"/>
<meta content="eMuleBB" name="author"/>
<meta content="Languages | eMule broadband edition" property="og:title"/>
<meta content="Choose a localized eMuleBB website page." property="og:description"/>
<meta content="website" property="og:type"/>
<meta content="{{ page.url }}" property="og:url"/>
{% if brand %}
<meta content="{{ site_base_url }}/{{ brand.social_path }}" property="og:image"/>
<meta content="1280" property="og:image:width"/>
<meta content="640" property="og:image:height"/>
<meta content="image/png" property="og:image:type"/>
<meta content="{{ brand.social_alt }}" property="og:image:alt"/>
<meta content="summary_large_image" name="twitter:card"/>
<meta content="{{ site_base_url }}/{{ brand.social_path }}" name="twitter:image"/>
<meta content="{{ brand.social_alt }}" name="twitter:image:alt"/>
{% else %}<meta content="summary" name="twitter:card"/>{% endif %}
<link href="{{ page.url }}" rel="canonical"/>
<link href="{{ site_base_url }}/sitemap.xml" rel="sitemap" type="application/xml"/>
{%- for alternate in alternates %}
<link href="{{ alternate.url }}" hreflang="{{ alternate.hreflang }}" rel="alternate"/>
{%- endfor %}
<link href="{{ page.favicon_href }}" rel="icon" type="image/x-icon"/>
<title>Languages | eMule broadband edition</title>
<link href="{{ pico_cdn }}" rel="stylesheet"/>
<link href="../styles.css" rel="stylesheet"/>
<script async src="https://www.googletagmanager.com/gtag/js?id={{ ga_measurement_id }}"></script>
<script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', '{{ ga_measurement_id }}');
    </script>
</head>
<body>
<a class="skip-link" href="#top">Skip to content</a>
<header class="site-header">
<a aria-label="eMule broadband edition home" class="brand brand-text" href="../">{% if brand %}<img class="brand-logo" src="{{ asset_prefix }}{{ brand.logo_path }}" width="256" height="256" alt=""/>{% endif %}<span dir="ltr">eMuleBB</span></a>
<a class="button secondary" href="../">English</a>
</header>
<main class="language-page" id="top">
<section class="section language-hero">
<p class="eyebrow">Languages</p>
<h1>Choose your eMuleBB language</h1>
<p class="lead">Choose an evergreen introduction or FAQ. English carries current product and release guidance; translated copy stays stable.</p>
<div class="actions">
<a class="button secondary" href="../">Back to English</a>
</div>
</section>
<section class="section">
<div class="language-groups">
{%- for group in groups %}
<article>
<h2>{{ group.label }}</h2>
<div class="language-list">
{%- for link in group.links %}
<a href="{{ link.href }}" hreflang="{{ link.hreflang }}">{{ link.label }}</a>
{%- endfor %}
</div>
</article>
{%- endfor %}
</div>
</section>
</main>
</body>
</html>
